# Template only. Copy to an ignored local file or enter values in server hosting settings.
# The application reads process environment variables; it does not automatically load this file.
# Never use VITE_ names for credentials: frontend variables can enter the browser bundle.
NCDAI_ENV=local
DATABASE_URL=sqlite:///./ncdai.db
# Replace with a generated secret before use; keep the same secret across server instances.
NCDAI_SECRET_KEY=
NCDAI_SECURE_COOKIES=false
NCDAI_PUBLIC_ORIGIN=http://127.0.0.1:5173
NCDAI_ALLOW_DEMO_SEED=false

# DeepSeek is the selected first provider. Disabled is the safe unconfigured default.
NCDAI_AI_PROVIDER=disabled
NCDAI_AI_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
# Only used if NCDAI_AI_PROVIDER=openai, with an explicitly selected supported model.
OPENAI_API_KEY=

# Hosted configuration requires all of the following changes:
# NCDAI_ENV=production
# DATABASE_URL=postgresql+psycopg://APP_ROLE:PASSWORD@DB_HOST/DB_NAME?sslmode=require
# NCDAI_SECRET_KEY=<strong independently generated value of at least 48 characters>
# NCDAI_SECURE_COOKIES=true
# NCDAI_PUBLIC_ORIGIN=https://<exact-assigned-application-domain>
# NCDAI_ALLOW_DEMO_SEED=false
# NCDAI_AI_PROVIDER=deepseek
# Supply DEEPSEEK_API_KEY only to the backend runtime; GitHub secrets are not Vercel secrets.
# Keep migration-owner/direct database credentials in a separate maintenance environment.
# No environment switch enables real patient records in this release.
